# Copy this file to .env and fill in real values. Never commit .env.

# --- TallyPrime ---
TALLY_URL=http://localhost:9000
TALLY_TIMEOUT_SECONDS=15
TALLY_COMPANY=

# --- Frappe cloud ERP ---
FRAPPE_BASE_URL=https://your-instance.frappe.cloud
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_TIMEOUT_SECONDS=15

# --- Retry engine ---
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=2

# --- Sync ---
SYNC_INTERVAL_MINUTES=15
STATE_DB_PATH=.state/sync_state.db
FRAPPE_MAPPING_FILE=frappe/mapping.yaml

# --- Logging ---
LOG_LEVEL=INFO
DEBUG_MODE=false
LOG_DIR=logs
